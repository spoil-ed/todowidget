{
  "name": "todowidget",
  "version": "2.0.2",
  "private": true,
  "description": "Minimal Windows TODO app with calendar views",
  "author": "TodoWidget",
  "main": "background.js",
  "scripts": {
    "serve": "cross-env NODE_OPTIONS=--openssl-legacy-provider vue-cli-service serve",
    "build": "cross-env NODE_OPTIONS=--openssl-legacy-provider vue-cli-service build",
    "lint": "vue-cli-service lint",
    "electron:build": "cross-env NODE_OPTIONS=--openssl-legacy-provider vue-cli-service electron:build",
    "electron:serve": "cross-env NODE_OPTIONS=--openssl-legacy-provider vue-cli-service electron:serve",
    "postinstall": "electron-builder install-app-deps",
    "test": "jest"
  },
  "dependencies": {
    "bootstrap": "^5.3.0",
    "bootstrap-icons": "^1.10.5",
    "core-js": "^3.20.1",
    "electron-store": "^7.0.3",
    "lodash.uniqueid": "^4.0.1",
    "moment": "^2.29.1",
    "vue": "^3.2.26",
    "vuex": "^4.0.2"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.0.0",
    "@vue/cli-plugin-babel": "^4.5.15",
    "@vue/cli-plugin-eslint": "^4.5.15",
    "@vue/cli-service": "^4.5.15",
    "@vue/compiler-sfc": "^3.2.26",
    "babel-eslint": "^10.1.0",
    "babel-jest": "^29.0.0",
    "cross-env": "^10.1.0",
    "electron": "^25.0.1",
    "electron-devtools-installer": "^3.1.0",
    "eslint": "^6.7.2",
    "eslint-plugin-vue": "^7.20.0",
    "jest": "^29.0.0",
    "sass": "^1.69.5",
    "sass-loader": "^10",
    "vue-cli-plugin-electron-builder": "~2.0.0-rc.6",
    "webpack": "4.46.0"
  },
  "overrides": {
    "vue-cli-plugin-electron-builder": {
      "electron-builder": "^23.0.3"
    }
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {
      "^.+\\.js$": "babel-jest"
    },
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}
